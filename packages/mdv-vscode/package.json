{
  "name": "mdv-vscode",
  "displayName": "MDV — Markdown Data & Visualization Preview",
  "description": "Live preview for .mdv files: charts, tables, stats, named styles, themes, TOC.",
  "version": "0.1.1",
  "publisher": "drasimwagan",
  "license": "MIT",
  "icon": "assets/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/drasimwagan/mdv.git",
    "directory": "packages/mdv-vscode"
  },
  "bugs": "https://github.com/drasimwagan/mdv/issues",
  "homepage": "https://github.com/drasimwagan/mdv#readme",
  "keywords": [
    "markdown",
    "mdv",
    "data visualization",
    "charts",
    "dashboard",
    "report",
    "preview"
  ],
  "galleryBanner": {
    "color": "#1e1e2a",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "activationEvents": [
    "onLanguage:mdv",
    "onCommand:mdv.openPreview",
    "onCommand:mdv.openPreviewToSide"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "mdv",
        "aliases": [
          "MDV",
          "Markdown Data & Visualization"
        ],
        "extensions": [
          ".mdv"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "mdv",
        "scopeName": "source.mdv",
        "path": "./syntaxes/mdv.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "mdv.openPreview",
        "title": "MDV: Open Preview",
        "category": "MDV",
        "icon": "$(open-preview)"
      },
      {
        "command": "mdv.openPreviewToSide",
        "title": "MDV: Open Preview to the Side",
        "category": "MDV",
        "icon": "$(open-preview)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "when": "resourceExtname == .mdv",
          "command": "mdv.openPreviewToSide",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "mdv.openPreview",
          "when": "resourceExtname == .mdv"
        },
        {
          "command": "mdv.openPreviewToSide",
          "when": "resourceExtname == .mdv"
        }
      ]
    },
    "keybindings": [
      {
        "command": "mdv.openPreviewToSide",
        "key": "ctrl+shift+v",
        "mac": "cmd+shift+v",
        "when": "editorLangId == mdv"
      }
    ]
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "npm run typecheck && node esbuild.config.mjs",
    "vscode:prepublish": "npm run build",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@mdv/core": "0.1.0",
    "@types/vscode": "^1.120.0",
    "@vscode/vsce": "^3.9.1",
    "esbuild": "^0.28.0"
  }
}
